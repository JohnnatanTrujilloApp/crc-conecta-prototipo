# Variables públicas: pueden estar disponibles en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key

# Variable privada: nunca use el prefijo NEXT_PUBLIC_ ni la importe en UI.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-environment
